{
  "protocolVersion": 1,
  "id": "com.4096bytes.momopet.momo",
  "version": "1.0.1",
  "name": "Momo",
  "description": "MomoPet 内建的聪明灵动黑白燕尾猫。",
  "authors": [
    {
      "name": "4096bytes"
    }
  ],
  "license": {
