{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MomoPet",
  "version": "../package.json",
  "identifier": "com.4096bytes.momopet.live2d",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MomoPet",
        "url": "index.html/#/",
        "width": 360,
        "height": 280,
        "minWidth": 240,
        "minHeight": 180,
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "maximizable": false
      },
      {
        "label": "preference",
        "url": "index.html/#/preference",
        "visible": false,
        "title": "MomoPet Preferences",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 800,
        "minHeight": 600,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1421; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/assets/models/**/*",
          "$APPDATA/custom-models/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "shortDescription": "Cross-platform Live2D desktop pet foundation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["assets/tray.png", "assets/models"]
  }
}
