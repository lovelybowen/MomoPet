{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4096bytes.com/schemas/momopet-package-v1.schema.json",
  "title": "MomoPet Pet Package Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "version",
    "name",
    "authors",
    "license",
    "runtime",
    "presentation",
    "actions"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": { "$ref": "#/$defs/displayName" },
    "description": { "type": "string", "maxLength": 2048 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/author" }
    },
    "license": { "$ref": "#/$defs/license" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "contains": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "const": "idle" },
          "type": { "const": "motion" }
        }
      },
      "maxContains": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/motionAction" },
          { "$ref": "#/$defs/expressionAction" }
        ]
      }
    },
    "input": { "$ref": "#/$defs/input" },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
        "maxLength": 128
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "displayName": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "parameterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "url": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "file": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "not": { "const": "manifest.json" } }
          ]
        },
        "url": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "profileVersion", "entry"],
      "properties": {
        "type": { "const": "live2d-cubism" },
        "profileVersion": { "const": 1 },
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "pattern": "\\.model3\\.json$" }
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover"],
      "properties": {
        "cover": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "pattern": "\\.[Pp][Nn][Gg]$" }
          ]
        },
        "background": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "pattern": "\\.[Pp][Nn][Gg]$" }
          ]
        }
      }
    },
    "motionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "motionGroup", "motionIndex"],
      "properties": {
        "id": { "$ref": "#/$defs/actionId" },
        "name": { "$ref": "#/$defs/displayName" },
        "description": { "type": "string", "maxLength": 512 },
        "type": { "const": "motion" },
        "motionGroup": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "motionIndex": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "expressionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "expression"],
      "properties": {
        "id": { "$ref": "#/$defs/actionId" },
        "name": { "$ref": "#/$defs/displayName" },
        "description": { "type": "string", "maxLength": 512 },
        "type": { "const": "expression" },
        "expression": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "parameters"],
      "properties": {
        "mode": { "enum": ["standard", "keyboard", "gamepad"] },
        "parameters": { "$ref": "#/$defs/inputParameters" }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "gamepad" } }
          },
          "then": {
            "properties": {
              "parameters": { "required": ["gamepad"] }
            }
          }
        }
      ]
    },
    "inputParameters": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/parameterId" },
            "right": { "$ref": "#/$defs/parameterId" }
          }
        },
        "mouseButtons": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
          "additionalProperties": { "$ref": "#/$defs/parameterId" }
        },
        "pointer": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/parameterId" }
        },
        "gamepad": { "$ref": "#/$defs/gamepadParameters" }
      }
    },
    "gamepadParameters": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "axes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
          "additionalProperties": { "$ref": "#/$defs/parameterId" }
        },
        "thumbButtons": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
          "additionalProperties": { "$ref": "#/$defs/parameterId" }
        },
        "stickHands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/parameterId" },
            "right": { "$ref": "#/$defs/parameterId" }
          }
        }
      }
    },
    "httpUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://\\S+$"
    }
  }
}
