{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4096bytes.com/schemas/momopet-package-v1.schema.json",
  "title": "MomoPet Pet Package Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "version",
    "name",
    "authors",
    "license",
    "runtime",
    "presentation"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/reverseDomainId" },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": { "$ref": "#/$defs/displayName" },
    "description": { "type": "string", "maxLength": 2048 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/author" }
    },
    "license": { "$ref": "#/$defs/license" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "actions": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/animationAction" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reverseDomainId" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "reverseDomainId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "maxLength": 128
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "url": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file"],
      "properties": {
        "name": { "$ref": "#/$defs/displayName" },
        "file": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "not": { "const": "manifest.json" } }
          ]
        },
        "url": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "profileVersion", "entry"],
      "properties": {
        "type": { "const": "sprite2d" },
        "profileVersion": { "const": 1 },
        "entry": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "pattern": "\\.sprite\\.json$" }
          ]
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover"],
      "properties": {
        "cover": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "pattern": "\\.[Pp][Nn][Gg]$" }
          ]
        },
        "background": {
          "allOf": [
            { "$ref": "#/$defs/portablePath" },
            { "pattern": "\\.[Pp][Nn][Gg]$" }
          ]
        }
      }
    },
    "animationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "clip", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/actionId" },
        "name": { "$ref": "#/$defs/displayName" },
        "description": { "type": "string", "maxLength": 512 },
        "type": { "const": "animation" },
        "clip": { "$ref": "#/$defs/actionId" },
        "mode": { "enum": ["once", "toggle"] }
      }
    },
    "httpUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://\\S+$"
    }
  }
}
