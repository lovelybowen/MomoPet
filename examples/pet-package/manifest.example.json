{
  "protocolVersion": 1,
  "id": "com.example.momo",
  "version": "1.0.0",
  "name": "Momo",
  "description": "MomoPet V1 Sprite2D 宠物包示例。",
  "authors": [
    {
      "name": "Example Author",
      "url": "https://example.com"
    }
  ],
  "license": {
    "name": "Example redistribution license",
    "file": "LICENSE.txt"
  },
  "runtime": {
    "type": "sprite2d",
    "profileVersion": 1,
    "entry": "model/pet.sprite.json"
  },
  "presentation": {
    "cover": "resources/cover.png"
  },
  "actions": [
    {
      "id": "happy",
      "name": "开心",
      "type": "animation",
      "clip": "happy",
      "mode": "once"
    },
    {
      "id": "sleep",
      "name": "睡觉",
      "type": "animation",
      "clip": "sleep",
      "mode": "toggle"
    }
  ],
  "extensions": {}
}
